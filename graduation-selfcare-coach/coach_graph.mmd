---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	safety_guard(safety_guard)
	route_record(route_record)
	redirect(redirect)
	guard_answer(guard_answer<hr/><small><em>__interrupt = before</em></small>)
	route_intent(route_intent)
	handle_object(handle_object)
	rephrase(rephrase)
	empathy(empathy)
	clarify(clarify)
	absorb(absorb<hr/><small><em>__interrupt = before</em></small>)
	care(care)
	diagnose(diagnose)
	socratic_q(socratic_q)
	evaluate(evaluate)
	praise(praise)
	reflect(reflect)
	capture_insight(capture_insight<hr/><small><em>__interrupt = before</em></small>)
	hint(hint)
	reveal(reveal)
	closing(closing)
	enrich_agent(enrich_agent)
	tools(tools)
	__end__([<p>__end__</p>]):::last
	__start__ --> safety_guard;
	absorb -. &nbsp;risk&nbsp; .-> __end__;
	absorb -. &nbsp;ok&nbsp; .-> care;
	capture_insight -. &nbsp;risk&nbsp; .-> __end__;
	capture_insight -. &nbsp;ok&nbsp; .-> enrich_agent;
	care --> diagnose;
	clarify --> absorb;
	diagnose -. &nbsp;done&nbsp; .-> closing;
	diagnose -. &nbsp;teach&nbsp; .-> socratic_q;
	empathy -. &nbsp;ok&nbsp; .-> care;
	empathy -. &nbsp;vague&nbsp; .-> clarify;
	enrich_agent -. &nbsp;__end__&nbsp; .-> closing;
	enrich_agent -.-> tools;
	evaluate -.-> hint;
	evaluate -. &nbsp;correct&nbsp; .-> praise;
	evaluate -.-> reveal;
	guard_answer -. &nbsp;risk&nbsp; .-> __end__;
	guard_answer -. &nbsp;ok&nbsp; .-> route_intent;
	handle_object --> absorb;
	hint --> guard_answer;
	praise --> reflect;
	reflect --> capture_insight;
	rephrase --> guard_answer;
	route_intent -. &nbsp;stop&nbsp; .-> closing;
	route_intent -. &nbsp;answer&nbsp; .-> evaluate;
	route_intent -. &nbsp;object&nbsp; .-> handle_object;
	route_intent -. &nbsp;confused&nbsp; .-> rephrase;
	route_record -. &nbsp;record&nbsp; .-> empathy;
	route_record -. &nbsp;not_record&nbsp; .-> redirect;
	safety_guard -. &nbsp;risk&nbsp; .-> __end__;
	safety_guard -. &nbsp;ok&nbsp; .-> route_record;
	socratic_q --> guard_answer;
	tools --> enrich_agent;
	closing --> __end__;
	redirect --> __end__;
	reveal --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
